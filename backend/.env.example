CROMA_API_KEY=your_key_here
PORT=4000
CACHE_TTL_SECONDS=3600

# Si no hay CROMA_API_KEY real, el backend sirve datos de prueba automáticamente.
# Poné MOCK_MODE=true para forzar datos de prueba incluso con una key real configurada,
# o MOCK_MODE=false para forzar Croma real (fallará sin una key válida).
MOCK_MODE=
